{
  "uid": "emporia-kafka-lag",
  "title": "Emporia — Kafka Consumer Lag",
  "tags": ["emporia", "kafka", "phase-1-2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "description": "REWORK_NOTE Phase 1_2. Lag panels read broker-side kafka-exporter metrics, which keep reporting when a consumer process is down. Application-side panels are supporting evidence only. All exporter lag is clamp_min'd because the exporter reports -1 for partitions with no committed offset, and all app-side queries filter to dotted topics because Micrometer emits every Kafka series twice.",
  "templating": {
    "list": [
      {
        "name": "consumergroup",
        "label": "Consumer group",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(kafka_consumergroup_lag, consumergroup)", "refId": "A" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": ["order-data-service-v1", "emporia-execution-service-v1", "order-management-executions-v1"],
          "value": ["order-data-service-v1", "emporia-execution-service-v1", "order-management-executions-v1"]
        },
        "description": "Defaults to the three stable groups. The ephemeral order-command-service-{uuid} and order-stream-{uuid} groups are selectable but appear and disappear by design."
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up{job=~\"emporia.*\"}, service)", "refId": "A" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Broker-side lag (source of truth)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Total lag — selected groups",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(clamp_min(kafka_consumergroup_lag{consumergroup=~\"$consumergroup\"}, 0))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "description": "Thresholds match KAFKA_LAG_WARN_THRESHOLD (100) and KAFKA_LAG_FAIL_THRESHOLD (1000) in scripts/perf/kafka-lag-check.sh. These are placeholders until a baseline load run replaces them."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Worst partition lag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(clamp_min(kafka_consumergroup_lag{consumergroup=~\"$consumergroup\"}, 0))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "description": "A single hot partition can stall while the group total looks healthy, so this is tracked separately from the sum."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Groups with no live member",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kafka_consumergroup_members{consumergroup=~\"$consumergroup\"} == 0) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "description": "A group whose consumers all died keeps its committed offsets, so lag looks fine until the backlog builds. Counts only groups the exporter still reports; a group that has vanished entirely shows up in the health table below, not here."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Kafka exporter",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "refId": "A", "expr": "up{job=\"kafka-exporter\"}", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "description": "Every lag panel on this dashboard is blank and meaningless if this is DOWN. Check it first before concluding lag is zero."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Current lag by group and topic",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (clamp_min(kafka_consumergroup_lag{consumergroup=~\"$consumergroup\"}, 0))",
          "legendFormat": "{{consumergroup}} → {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lag growth rate (records/sec)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "deriv(sum by (consumergroup) (clamp_min(kafka_consumergroup_lag{consumergroup=~\"$consumergroup\"}, 0))[5m:])",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "axisSoftMin": 0 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "description": "Sustained positive values mean consumers are falling behind producers. This matters more than absolute lag: a steady lag of 500 is stable, a lag of 50 growing at 10/s is not."
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top lagging partitions",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, clamp_min(kafka_consumergroup_lag{consumergroup=~\"$consumergroup\"}, 0))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true, "__name__": true }, "renameByName": { "Value": "lag" } } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "lag", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "lag" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] }
              }
            ]
          }
        ]
      },
      "description": "Partition-level view. Lag concentrated on one partition usually means a hot key rather than an undersized consumer."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Consumer group members",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumergroup_members{consumergroup=~\"$consumergroup\"}",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "description": "Drops to 0, or the series disappearing entirely, means the owning service is not running. Gaps are shown rather than interpolated so a vanished group is visible."
    },
    {
      "type": "row",
      "title": "Application-side consumer behaviour (supporting evidence)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Records consumed rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, topic) (kafka_consumer_fetch_manager_records_consumed_rate{service=~\"$service\", topic=~\"emporia\\\\..+\"})",
          "legendFormat": "{{service}} → {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "description": "Filtered to dotted topics. Micrometer emits every Kafka series twice — once as emporia.orders.v1 and once as emporia_orders_v1 — so an unfiltered sum double-counts. A rate near zero while lag climbs is the classic stalled-consumer signature."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Rebalance rate (per hour)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, client_id) (kafka_consumer_coordinator_rebalance_rate_per_hour{service=~\"$service\"})",
          "legendFormat": "{{service}} / {{client_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 6 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "description": "Continuous rebalancing stops progress without ever showing an error. Expect near-zero once the group is stable; the ephemeral request/reply consumers rebalance on every service restart by design."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Commit latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, client_id) (kafka_consumer_coordinator_commit_latency_avg{service=~\"$service\"})",
          "legendFormat": "avg — {{service}} / {{client_id}}"
        },
        {
          "refId": "B",
          "expr": "sum by (service, client_id) (kafka_consumer_coordinator_commit_latency_max{service=~\"$service\"})",
          "legendFormat": "max — {{service}} / {{client_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Assigned partitions and failed rebalances",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, client_id) (kafka_consumer_coordinator_assigned_partitions{service=~\"$service\"})",
          "legendFormat": "assigned — {{service}} / {{client_id}}"
        },
        {
          "refId": "B",
          "expr": "sum by (service, client_id) (rate(kafka_consumer_coordinator_failed_rebalance_total{service=~\"$service\"}[5m]))",
          "legendFormat": "failed rebalances/s — {{service}} / {{client_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "description": "A consumer assigned zero partitions is consuming nothing regardless of what the lag panels show."
    }
  ]
}
