<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.emporia</groupId>
    <artifactId>emporia-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>21</java.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <pmd.version>7.26.0</pmd.version>
        <pmd.failOnViolation>true</pmd.failOnViolation>
        <!--
          JDBC observation instrumentation, not managed by the Spring Boot BOM.
          Must stay on the 2.x line: 1.x fails to start on Spring Boot 4 with
          NoClassDefFoundError on ObservationRegistryCustomizer, which Boot 4
          repackaged. Note that the search.maven.org API reports a stale latest
          version for this artifact; repo1 maven-metadata.xml is authoritative.
        -->
        <datasource-micrometer.version>2.2.1</datasource-micrometer.version>
        <jqwik.version>1.10.1</jqwik.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>authentication</module>
        <module>trading-contracts</module>
        <module>emporia-ha-core</module>
        <module>emporia-algorithmic-strategies</module>
        <module>emporia-journal</module>
        <module>fix-simulator-contracts</module>
        <module>fix-market-simulator</module>
        <module>static-data-service</module>
        <module>user-preferences-service</module>
        <module>market-data-service</module>
        <module>order-management-service</module>
        <module>portfolio-service</module>
        <module>gateway</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.15</version>
                    <configuration>
                        <excludes>
                            <!-- exclude generated protobuf / FIX / gRPC classes -->
                            <exclude>org/fixprotocol/*</exclude>
                            <exclude>org.fixprotocol.*</exclude>
                            <exclude>com/emporia/marketdata/grpc/*</exclude>
                            <exclude>com.emporia.marketdata.grpc.*</exclude>
                            <exclude>com/emporia/model/*</exclude>
                            <exclude>com.emporia.model.*</exclude>
                            <exclude>com/emporia/*/grpc/*</exclude>
                            <exclude>com.emporia.*.grpc.*</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetJdk>${java.version}</targetJdk>
                    <rulesets>
                        <ruleset>${project.parent.basedir}/static-analysis/ruleset.xml</ruleset>
                    </rulesets>
                    <includeTests>false</includeTests>
                    <linkXRef>false</linkXRef>
                    <printFailingErrors>true</printFailingErrors>
                    <skipPmdError>false</skipPmdError>
                    <failOnViolation>${pmd.failOnViolation}</failOnViolation>
                    <excludeRoots>
                        <excludeRoot>${project.build.directory}/generated-sources</excludeRoot>
                        <excludeRoot>${project.build.directory}/generated-test-sources</excludeRoot>
                    </excludeRoots>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
